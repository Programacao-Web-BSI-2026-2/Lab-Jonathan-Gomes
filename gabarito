<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="description" content="Exemplo de formulário para busca no Google">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="keywords" content="HTML, Formulário, Busca Google">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Ronaldo Amaral">
    <title>Buscador Google</title>
</head>
<body>
    <form class="" action="http://www.google.com.br/search" method="get">
        <label for="pesquisar">Pesquisar:</label>
        <input type="search" name="q" value="" id="pesquisar" placeholder="Digite aqui">
        <input type="submit" name="name" value="Buscar">
        <input type="reset" name="name" value="Limpar">
    </form>
</body>
</html>
