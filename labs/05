<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Grade Horária de Aulas do Módulo</title>
</head>
<body>

    <main>

        <!-- MÓDULO 5: HORÁRIOS DAS AULAS -->
        <section class="bloco-cronograma" aria-labelledby="titulo-horarios">
            <h2 id="titulo-horarios" class="titulo-seccao">Horários acadêmicos</h2>

            <table>
                <caption>Grade horária das aulas do módulo</caption>
                <thead>
                    <tr>
                        <th scope="col">Aula</th>
                        <th scope="col">Horário</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">Estruturação Multimídia</th>
                        <td>19:00 - 20:30</td>
                    </tr>
                </tbody>
            </table>

            <p id="recursos-necessarios">Recursos necessários:</p>
            <ul aria-labelledby="recursos-necessarios">
                <li>Computador com IDE configurada</li>
                <li>Arquivos de legenda (.vtt) prontos</li>
            </ul>
        </section>

        <hr>

        <!-- MÓDULO 6: CONTEÚDO INTEGRADO -->
        <section class="bloco-video" aria-labelledby="titulo-video">
            <h2 id="titulo-video">Apresentação da Disciplina</h2>
            <video controls preload="metadata" width="640">
                <source src="apresentacao.mp4" type="video/mp4">
                <track kind="captions" src="apresentacao.pt.vtt" srclang="pt" label="Português" default>
                <p>
                    O seu navegador não suporta vídeo HTML5.
                    <a href="apresentacao.mp4">Descarregue o vídeo</a>.
                </p>
            </video>
        </section>

        <section class="bloco-mapa" aria-labelledby="titulo-mapa">
            <h2 id="titulo-mapa">Localização do Campus IFF</h2>
            <iframe
                src="https://mapas.iff.edu.br"
                title="Mapa interativo com a localização do Campus IFF"
                width="600"
                height="450"
                sandbox="allow-scripts allow-same-origin"
                referrerpolicy="no-referrer"
                loading="lazy"></iframe>
        </section>

    </main>

</body>
</html>
