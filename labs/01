
<!DOCTYPE html>
 <html lang="pt-BR">
  <head>
     <title>Tela de suporte a o cliente</title>
     <meta charset="UTF-8">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <meta name="description" content="Área de contato do cliente para envio de mensagens ao suporte técnico.">
    <title>Área de Contato do Cliente</title>
  </head>
  <body>
      <header>
         <h1>Área de Contato do Cliente</h1>
         <nav aria-label="Menu principal">
             <ul>
                 <li><a href="#">Ajuda</a></li>
                 <li><a href="#">Sair</a></li>
            </ul>
         </nav>
      </header>
  
      <main>

        <form action="#" method="post" aria-label="Formulário de contato">
            
                <label for="nome">Nome</label>
                <input id="nome" name="nome" type="text" autocomplete="name" required><br><br>
            
 
             
                 <label for="email">E-mail</label>
                 <input id="email" name="email" type="email" autocomplete="email" required><br><br>
            
 
             
                 <label for="celular">Telefone celular</label>
                 <input id="celular" name="celular" type="tel" autocomplete="tel" inputmode="numeric" required><br><br>
             
 
             
                 <label for="mensagem">Mensagem</label><br><br>
                 <textarea id="mensagem" name="mensagem" rows="5" required></textarea><br><br>
            
 
             <button type="submit">Enviar mensagem</button>
          </form>
      </main>
  
      <footer>
         <p>Suporte Tech 2026</p>
      </footer>
  </body>
  </html>
